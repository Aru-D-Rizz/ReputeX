# ReputeX Backend API Environment Template
PORT=5000
NODE_ENV=production

# OpenRouter AI Credentials (Primary Provider)
OPENROUTER_API_KEY=sk-or-v1-YOUR_OPENROUTER_API_KEY_HERE
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions

# Etherscan V2 Explorer API Key
ETHERSCAN_API_KEY=CAQQYTH2TSFZ27NKWHF7W2QP3S7BYII7IB

# CoinGecko Demo / Pro API Key
COINGECKO_API_KEY=YOUR_COINGECKO_API_KEY

# Supabase PostgreSQL Database (Pooler Connection URL)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_KEY=sb_publishable_YOUR_KEY

# Dynamic CORS Allowed Origins (Comma-Separated)
ALLOWED_ORIGINS=https://reputex.vercel.app,https://repute-x-iota.vercel.app,http://localhost:3000
